{
  "terminal.integrated.fontWeight": "normal",
  "editor.fontLigatures": true,
  "terminal.integrated.automationProfile.linux": {},
  "task.slowProviderWarning": true,
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono', 'monospace', monospace",
  "git.enableSmartCommit": true,
  "javascript.inlayHints.parameterNames.enabled": "all",
  "omnisharp.sdkPath": "/usr/local/bin/dotnet/sdk",
  "editor.fontFamily": "'FiraCode Nerd Font Mono', 'monospace', monospace",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },
  "dotnet.codeLens.enableReferencesCodeLens": false,
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "editor.minimap.enabled": false,
  "prettier.printWidth": 120,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
  },
  "notebook.output.scrolling": true,
  "notebook.lineNumbers": "on",
  "[opencl]": {
    "editor.defaultFormatter": "galarius.vscode-opencl"
  },
  "files.associations": {
    "*.hip": "cpp"
  },
  "catppuccin.accentColor": "",
  "vscord.app.name": "VSCodium",
  "vscord.status.details.text.notInFile": "Idling",
  "mesonbuild.downloadLanguageServer": true,
  "editor.inlayHints.enabled": "off",
  "[meson]": {
    "editor.defaultFormatter": "mesonbuild.mesonbuild"
  },
  "vscord.status.details.text.viewing": "In {workspace}",
  "vscord.status.state.text.editing": "Working on {file_name}{file_extension}",
  "ltex.language": "en-AU",
  "editor.lineNumbers": "relative",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "keyboard.dispatch": "keyCode",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jinja-html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "markdown.extension.theming.decoration.renderCodeSpan": false,
  "markdown.extension.theming.decoration.renderStrikethrough": false,
  "editor.wordWrap": "on",
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
    "*.csproj": "${capture}.csproj.user",
    "*.json": "${capture}.Development.json",
    "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
    "*.razor": "${capture}.razor.cs,${capture}.razor.css",
    "*.resx": "${capture}.Designer.cs",
    "*.xaml": "${capture}.xaml.cs",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "window.newWindowProfile": "Default",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.colorTheme": "",
  "redhat.telemetry.enabled": false,
  "editor.tabSize": 2,
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "pgsql.serverGroups": [
    {
      "name": "Servers",
      "id": "6AF56B12-03C9-47DA-91E4-B2F4F92A748C",
      "isDefault": true
    }
  ],
  "ty.interpreter": "",
  "ty.path": [
    "/usr/bin/ty"
  ],
  "ruff.interpreter": [
    "/usr/bin/ruff"
  ]
}
